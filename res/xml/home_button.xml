<?xml version="1.0" encoding="utf-8"?>
<!-- HomeButton: only sees when a stock home screen opens. It can't see keys or read what's on screen.
     The list covers Google TV's launcher, Android TV 9-11's launcher and the older leanback one. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.tvlauncher,com.google.android.leanbacklauncher"
    android:notificationTimeout="0" />
